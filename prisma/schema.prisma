// Schéma de base de données — Plateforme d'examens FLE
// Utilise PostgreSQL (Neon, Supabase, Railway... toutes offrent un tier gratuit).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
}

enum UserStatus {
  active
  inactive
}

model User {
  id           String    @id @default(cuid())
  role         Role
  email        String    @unique
  name         String
  passwordHash String
  status       UserStatus @default(active)
  niveau       String?
  grade        String?
  createdAt    DateTime  @default(now())
  lastLogin    DateTime?

  assignments  Assignment[]
  sessions     ExamSession[]
  projectAssignments ProjectAssignment[]

  @@index([role])
}

model AccessRequest {
  id        String   @id @default(cuid())
  prenom    String
  nom       String
  email     String
  niveau    String
  grade     String?  // "classe" (préscolaire/primaire) ou "niveau secondaire" selon le cas
  groupe    String?  // uniquement pertinent pour préscolaire/primaire
  status    String   @default("pending") // pending | accepted | refused
  createdAt DateTime @default(now())
}

model Exam {
  id                String   @id @default(cuid())
  titre             String
  niveau            String
  matiere           String   @default("Français") // Français | Sciences — détermine si la production orale a un sens
  statut            String   @default("brouillon") // brouillon | publié | archivé
  navMode           String   @default("libre")     // libre | sequentiel
  duree             Int      @default(0)            // minutes, 0 = illimité
  autoriserReprise  Boolean  @default(true)
  imported          Boolean  @default(false)
  verified          Boolean  @default(true)
  sections          Json     // structure flexible : [{id,titre,questions:[...]}]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  assignments Assignment[]
  sessions    ExamSession[]

  @@index([niveau])
  @@index([statut])
}

model Assignment {
  id        String  @id @default(cuid())
  examId    String
  teacherId String?
  classe    String?
  groupe    String?

  exam    Exam  @relation(fields: [examId], references: [id], onDelete: Cascade)
  teacher User? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  sessions ExamSession[]

  @@index([teacherId])
  @@index([examId])
}

model ExamSession {
  id           String    @id @default(cuid())
  examId       String
  teacherId    String?
  assignmentId String?
  token        String    @unique
  statut       String    @default("préparé") // préparé | en_cours | terminé | archivé
  createdAt    DateTime  @default(now())
  startedAt    DateTime?
  endedAt      DateTime?

  exam       Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  teacher    User?       @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  assignment Assignment? @relation(fields: [assignmentId], references: [id])
  attempts   Attempt[]

  @@index([token])
  @@index([teacherId])
}

model Attempt {
  id           String    @id @default(cuid())
  sessionId    String
  secret       String    // returned once to the student's browser; required to PATCH/submit this attempt
  nom          String
  niveau       String
  classe       String?
  groupe       String?
  reponses     Json      @default("{}")
  incidents    Json      @default("[]")
  away         Boolean   @default(false) // true = a quitté l'onglet/la page en ce moment (suivi en direct pour le professeur)
  statut       String    @default("en_cours") // en_cours | soumis
  startedAt    DateTime  @default(now())
  submittedAt  DateTime?

  session ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  result  Result?

  @@index([sessionId])
}

model Result {
  id             String   @id @default(cuid())
  attemptId      String   @unique
  sectionScores  Json     @default("{}")
  manualScores   Json     @default("{}")
  autoDetail     Json     @default("{}")
  oralNote       Float?
  total          Float    @default(0)
  max            Float    @default(0)
  pct            Int      @default(0)
  manualPending  Boolean  @default(false)
  visibleEleve   Boolean  @default(false)
  updatedAt      DateTime @updatedAt

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id      String   @id @default(cuid())
  action  String
  details String?
  at      DateTime @default(now())
}

model Project {
  id          String   @id @default(cuid())
  titre       String
  description String?
  niveau      String
  matiere     String   @default("Français")
  statut      String   @default("brouillon") // brouillon | publié | archivé
  media       String?  // image d'illustration, optionnelle
  criteria    Json     // [{id, titre, points}] — la grille définie par l'admin
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments ProjectAssignment[]
}

model ProjectAssignment {
  id        String @id @default(cuid())
  projectId String
  teacherId String?
  classe    String?
  groupe    String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  teacher User?   @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  entries ProjectEntry[]

  @@index([teacherId])
  @@index([projectId])
}

model ProjectEntry {
  id           String   @id @default(cuid())
  assignmentId String
  nom          String
  classe       String?
  groupe       String?
  scores       Json     @default("{}") // { criteriaId: pointsGiven }
  total        Float    @default(0)
  max          Float    @default(0)
  pct          Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignment ProjectAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
}

// Fichiers importés (images/audio) — stockés en base pour survivre aux
// redéploiements (le disque de Render est éphémère). À garder petits : une
// limite de taille est appliquée à l'envoi.
model UploadedFile {
  id        String   @id @default(cuid())
  mimeType  String
  data      String   // base64
  size      Int
  createdAt DateTime @default(now())
}

// Réglages de l'établissement — un seul enregistrement ("singleton").
model Settings {
  id           String  @id @default("singleton")
  schoolLogoId String?
}

// ============ SUIVI DES ÉVALUATIONS (réservé à l'administrateur) ============
// Structure maîtresse de l'établissement, saisie une seule fois : Section > Classe > Groupe,
// plus les listes de matières et de niveaux. Elle sert ensuite aux trois suivis (Guide, Examen, Projet).
model SuiviYear {
  id        String   @id @default(cuid())
  label     String   @unique
  createdAt DateTime @default(now())
}

model SuiviNode {
  id        String   @id @default(cuid())
  parentId  String?
  kind      String   // section | classe | groupe
  nom       String
  niveau    String?  // niveau (liste maîtresse) associé à un groupe, facultatif
  ordre     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([parentId])
}

model SuiviMatiere {
  id    String @id @default(cuid())
  nom   String
  ordre Int    @default(0)
}

model SuiviNiveau {
  id    String @id @default(cuid())
  nom   String
  ordre Int    @default(0)
}

// Statut courant d'un document : (année, trimestre, type, groupe ou classe, matière) -> 0..6
model SuiviStatus {
  id         String   @id @default(cuid())
  annee      String
  trimestre  Int
  type       String   // guide | examen | projet
  leafId     String   // id du groupe (ou de la classe s'il n'y a pas de groupe)
  matiereId  String
  statut     Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([annee, trimestre, type, leafId, matiereId])
  @@index([annee, trimestre])
}

// Historique : chaque changement de statut est enregistré automatiquement.
model SuiviHistory {
  id         String   @id @default(cuid())
  annee      String
  trimestre  Int
  type       String
  leafId     String
  matiereId  String
  statut     Int
  at         DateTime @default(now())
  par        String?

  @@index([annee, trimestre, type, leafId, matiereId])
}

// ============ DOCUMENTS PÉDAGOGIQUES (apprentissages attendus, guides de révision) ============
model PedaDocument {
  id        String   @id @default(cuid())
  userId    String
  type      String   // apprentissages | guide
  titre     String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, type])
}
